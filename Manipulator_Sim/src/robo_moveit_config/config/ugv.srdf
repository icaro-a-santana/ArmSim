<?xml version="1.0" encoding="UTF-8"?>
<!-- [ARQUIVO NOVO] Definição Semântica do Robô para o MoveIt -->
<robot name="PENSAR">

    <!-- DEFINIÇÃO DO GRUPOS -->
    <!-- Grupo de planejamento para o braço, usando cadeia cinemática da base até a mão -->
    <group name="arm">
        <chain base_link="base_link" tip_link="hand_link"/>
    </group>
    <!-- Grupo de planejamento da garra, agrupando os links e juntas dos 'dedos' -->
    <group name="gripper">
        <link name="right_gripper_link"/>
        <link name="left_gripper_link"/>
        <joint name="hand_right_gripper_joint"/>
        <joint name="hand_left_gripper_joint"/>
    </group>

    <!-- DEFINIÇÃO DAS POSES -->
    <!-- Poses nomeadas: Posição de repouso (home) para o braço -->
    <group_state name="home" group="arm">
        <joint name="base_second_joint" value="0"/>
        <joint name="second_third_joint" value="0"/>
        <joint name="third_fourth_joint" value="0"/>
        <joint name="fourth_hand_joint" value="0"/>
    </group_state>
    
    <!-- Poses nomeadas para a garra: Aberta -->
    <group_state name="open" group="gripper">
        <joint name="hand_right_gripper_joint" value="0"/>
        <joint name="hand_left_gripper_joint" value="0"/>
    </group_state>
    
    <!-- Poses nomeadas para a garra: Fechada -->
    <group_state name="close" group="gripper">
        <joint name="hand_right_gripper_joint" value="1.0"/>
        <joint name="hand_left_gripper_joint" value="-1.0"/>
    </group_state>

    <!-- TRATAMENTO DAS COLIÇÕES -->
    <!-- Matriz de colisão (ACM): Desabilita verificação de colisão entre links adjacentes e que nunca se tocam -->
    <disable_collisions link1="base_link" link2="second_link" reason="Adjacent"/>
    <disable_collisions link1="second_link" link2="third_link" reason="Adjacent"/>
    <disable_collisions link1="third_link" link2="fourth_link" reason="Adjacent"/>
    <disable_collisions link1="fourth_link" link2="hand_link" reason="Adjacent"/>
    <disable_collisions link1="hand_link" link2="right_gripper_link" reason="Adjacent"/>
    <disable_collisions link1="hand_link" link2="left_gripper_link" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_link" link2="left_gripper_link" reason="Never"/>
</robot>
