<launch>
  <arg name="package_name" default="robo_gazebo_sim"/>
  <arg name="urdf_file" default="ugv.urdf"/>
  
  <let name="pkg_share" value="$(find-pkg-share $(var package_name))"/>
  <let name="urdf_path" value="$(var pkg_share)/model/$(var urdf_file)"/>
  <let name="moveit_config_pkg" value="$(find-pkg-share robo_moveit_config)"/>

  <!-- Inicia o pick_place_cli lendo os arquivos urdf e srdf como parâmetros do nó -->
  <node pkg="robo_gazebo_sim" exec="pick_place_cli" name="pick_place_cli" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" type="str"/>
    <param name="robot_description_semantic" value="$(command 'cat $(var moveit_config_pkg)/config/ugv.srdf')" type="str"/>
    <!-- Para usar o relógio do simulador Gazebo -->
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
